{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // import.meta.env / *.css 사이드이펙트 import 타입 (Vite 제공)
    "types": ["vite/client", "node"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // baseUrl은 폐기 예정이라 TypeScript 버전이 오를 때 경고가 error로 올라와
    // 타입 검사 자체가 중단됐다. paths는 baseUrl 없이도 tsconfig 위치 기준으로
    // 해석되므로 아예 뺀다 (번들러 별칭은 vite.config.ts의 resolve.alias가 담당).
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
